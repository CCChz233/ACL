# Keep portable benchmark manifests, not downloaded data or host-specific status.
/benchmarks/*
!/benchmarks/README.md
!/benchmarks/sources.lock.json
!/benchmarks/all_benchmark_tasks.csv
!/benchmarks/*tasks.csv
!/benchmarks/test_repository_exclusions.json
!/benchmarks/verified_without_mini_ids.json
!/benchmarks/verified-mini-overlap.json
!/benchmarks/benchmark_relationships.json

